# ==============================================================================
# CareerPilot AI Configuration Template
# Copy this file to .env and fill in your confidential API keys and settings.
# ==============================================================================

# Notion Integration
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Candidate Profile Store Directory (defaults to ./profile)
PROFILE_DIR=profile

# Local Storage Directory for Cached Jobs & Deduplication Hash Store
STORAGE_DIR=storage

# Polite Scraping Settings (Rate Limits & Jitter in seconds)
SCRAPING_DELAY_MIN=2.0
SCRAPING_DELAY_MAX=6.5
SCRAPING_MAX_RETRIES=3
SCRAPING_REQUEST_TIMEOUT=15.0

# Deduplication Window in Days (PRD Section 5.2)
DEDUPLICATION_WINDOW_DAYS=90

# Default Search Target Preferences
DEFAULT_SEARCH_KEYWORDS="Software Engineer"
DEFAULT_SEARCH_LOCATION="Thailand"
